#!/bin/sh
# Git pre-push hook: refuses a push when any commit being pushed contains a
# hardcoded secret (API key, token, private key, etc.), detected via
# gitleaks. Git-level companion to deny-secret-commit.sh; see pre-commit.
#
# Git passes the remote's name as $1 and, on stdin, one line per ref being
# pushed:  <local ref> <local sha> <remote ref> <remote sha>
# so the commits to scan are known exactly, with no guessing from the
# upstream branch. A push that only deletes a remote branch has nothing to
# scan.
#
# Block: exit 1 + reason on stderr. Allow: exit 0. If gitleaks is not on
# PATH the push is allowed, with a warning.

remote="$1"
input=$(cat)

# An all-zeroes object name means "does not exist" (a new remote ref, or a
# local ref being deleted). Its length depends on the repo's hash format.
is_zero() {
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

# gitleaks also takes its settings from these environment variables, which a
# command can set for itself to replace the rules this scan relies on.
unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML

# gitleaks reads .gitleaks.toml and .gitleaksignore from the folder it scans
# (here, the top of the work tree) and skips whatever they tell it to. Only
# copies exactly as committed are trusted, and never a link, whose target
# git does not track.
is_settled() { # $1 = file; tracked, unchanged since the last commit, not a link
  # GIT_LITERAL_PATHSPECS: the name is a file, not a pattern (`*.toml`).
  [ ! -L "$1" ] && [ -e "$1" ] &&
    GIT_LITERAL_PATHSPECS=1 git ls-files --error-unmatch -- "$1" >/dev/null 2>&1 &&
    GIT_LITERAL_PATHSPECS=1 git diff --quiet HEAD -- "$1" >/dev/null 2>&1
}
# The `path` in a settings file's [extend] table, if any. gitleaks reads the
# file as TOML, which can spell the same setting many ways (quoted or dotted
# keys, inline tables, any capitals, escapes), so only the plain form is
# accepted: one `[extend]` header holding only `useDefault`, `disabledRules`
# and a `path` in plain quotes. Anything else that mentions extend prints
# "/", which is never trusted.
extend_path() {
  awk -v q="'" -v dq='"' '
    function count(s, d,   n, i) {
      n = 0
      while ((i = index(s, d)) > 0) { n++; s = substr(s, i + length(d)) }
      return n
    }
    BEGIN {
      bs = sprintf("%c", 92); sq3 = q q q; dq3 = dq dq dq
      str = "(" dq "[^" dq "]*" dq "|" q "[^" q "]*" q ")"
      item = "^[[:space:]]*(" str "[[:space:]]*,?[[:space:]]*)*[]]?[[:space:]]*(#.*)?$"
      other = "(^|[[:space:].{,]|" dq "|" q ")extend(" dq "|" q ")?[[:space:]]*[.=]"
    }
    # Inside a multi-line string: its lines are text, not settings.
    inml { if (count($0, delim) % 2) inml = 0; next }
    {
      l = tolower($0)
      ns = count($0, sq3); nd = count($0, dq3)
      # Multi-line strings never belong in [extend]; elsewhere they are
      # skipped over (gitleaks rules often use them for patterns).
      if (sec == "extend" && (ns || nd)) { bad = 1; exit }
      # A key spelled with \u escapes could hide the word extend.
      k = $0; sub(/=.*/, "", k)
      if (index(k, bs "u") || index(k, bs "U")) { bad = 1; exit }
      if (ns % 2) { inml = 1; delim = sq3 } else if (nd % 2) { inml = 1; delim = dq3 }
    }
    l ~ /^[[:space:]]*(#.*)?$/ { next }
    l ~ /^[[:space:]]*[[]/ {
      h = l; sub(/#.*/, "", h); gsub(/[[:space:]]/, "", h)
      # gitleaks headers are never quoted or escaped.
      if (index(h, dq) || index(h, q) || index(h, bs)) { bad = 1; exit }
      if (h == "[extend]") { sec = "extend"; seen++; next }
      if (h ~ /extend/) { bad = 1; exit }
      sec = ""; next
    }
    sec == "extend" {
      if (l ~ /^[[:space:]]*(usedefault|disabledrules)[[:space:]]*=/) next
      if (l ~ /^[[:space:]]*path[[:space:]]*=/) {
        v = $0; sub(/^[^=]*=[[:space:]]*/, "", v)
        c = substr(v, 1, 1); rest = substr(v, 2); e = index(rest, c)
        if (path != "" || (c != dq && c != q) || e < 2) { bad = 1; exit }
        path = substr(rest, 1, e - 1)
        if (index(path, bs) || substr(rest, e + 1) !~ /^[[:space:]]*(#.*)?$/) { bad = 1; exit }
        next
      }
      if (l ~ item) next
      bad = 1; exit
    }
    l ~ other { bad = 1; exit }
    END { if (bad || seen > 1) print "/"; else if (path != "") print path }
  ' < "$1"
}
# The file a .gitleaks.toml pulls in through `[extend] path`, when it names
# one inside the repo.
extended_file() {
  [ -f .gitleaks.toml ] || return 0
  x=$(extend_path .gitleaks.toml) || return 0
  case "$x" in ""|/*|"~"*|-*|*..*) ;; *) printf '%s\n' "$x" ;; esac
}
unsettled_settings() { # prints each settings file that is not trusted
  for f in .gitleaks.toml .gitleaksignore; do
    { [ -e "$f" ] || [ -L "$f" ]; } || continue
    is_settled "$f" || printf '%s\n' "$f"
  done
  # A trusted .gitleaks.toml can still pull in another file through
  # `[extend] path`. That file must be a plain file inside the repo, trusted
  # the same way, and must not extend anything further.
  if [ -f .gitleaks.toml ]; then
    p=$(extend_path .gitleaks.toml) || p=/
    case "$p" in
      "") ;;
      /*|"~"*|-*|*..*) printf '%s\n' .gitleaks.toml ;;
      *) { [ -f "$p" ] && is_settled "$p" && pp=$(extend_path "$p") && [ -z "$pp" ]; } ||
        printf '%s\n' .gitleaks.toml ;;
    esac
  fi
}

if command -v gitleaks >/dev/null 2>&1; then
  # A bare repo has no work tree, so settings files kept beside it are used
  # as they are.
  if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ]; then
    bad=$(unsettled_settings | sort -u | tr '\n' ' ')
    if [ -n "$bad" ]; then
      echo "Blocked by the secret guard (git pre-push hook, $0): gitleaks's settings file(s) ${bad}are new, changed, a link, pull in a file that is, or are not committed. gitleaks reads these files to decide what to skip, so a change to them can switch the secret scan off. If you are an agent, do not edit, delete or work around them; explain the block to the user. If the change is yours, check it and commit it (with \`git commit --no-verify\`), or undo it, then push again." >&2
      exit 1
    fi
  fi

  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    is_zero "$local_sha" && continue
    if ! is_zero "$remote_sha" && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
      # The remote ref exists and we have its commit: scan what is new.
      range="${remote_sha}..${local_sha}"
    else
      # New remote ref (or one whose current commit we don't have): scan
      # every commit being pushed that this remote is not already known
      # to hold, not just the tip.
      range="${local_sha} --not --remotes=${remote}"
    fi
    report=$(gitleaks git --no-banner --redact --no-color --ignore-gitleaks-allow --verbose --log-opts="$range" 2>&1)
    if [ "$?" = "1" ]; then
      echo "Blocked by the secret guard (git pre-push hook, $0): commit(s) about to be pushed to ${remote_ref} appear to contain a secret (gitleaks detected a match). Do not retry or work around this; rotate the credential and explain the block to the user. Details:" >&2
      printf '%s\n' "$report" >&2
      exit 1
    fi
  done <<EOF
$input
EOF
else
  echo "secret guard (git pre-push hook): gitleaks was not found on PATH, so this push was NOT scanned for secrets." >&2
fi

# core.hooksPath replaces the repo's own hooks folder, so hand on to the
# repo's own pre-push hook if it has one, with the same input.
own_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/pre-push"
if [ -x "$own_hook" ] && ! [ "$own_hook" -ef "$0" ]; then
  printf '%s\n' "$input" | "$own_hook" "$@"
  exit $?
fi

exit 0
