#!/bin/sh
# Git pre-push hook: refuses a push when any commit being pushed contains a
# hardcoded secret (API key, token, private key, etc.), detected via
# gitleaks. Git-level companion to deny-secret-commit.sh; see pre-commit.
#
# Git passes the remote's name as $1 and, on stdin, one line per ref being
# pushed:  <local ref> <local sha> <remote ref> <remote sha>
# so the commits to scan are known exactly, with no guessing from the
# upstream branch. A push that only deletes a remote branch has nothing to
# scan.
#
# Block: exit 1 + reason on stderr. Allow: exit 0. If gitleaks is not on
# PATH the push is allowed, with a warning.

remote="$1"
input=$(cat)

# An all-zeroes object name means "does not exist" (a new remote ref, or a
# local ref being deleted). Its length depends on the repo's hash format.
is_zero() {
  case "$1" in
    *[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

# gitleaks also takes its settings from these environment variables, which a
# command can set for itself to replace the rules this scan relies on.
unset GITLEAKS_CONFIG GITLEAKS_CONFIG_TOML

if command -v gitleaks >/dev/null 2>&1; then
  # gitleaks reads .gitleaks.toml and .gitleaksignore from the folder it
  # scans (here, the top of the work tree) and skips whatever they tell it
  # to. In a work tree, only copies exactly as committed are trusted (never
  # a link, whose target git does not track). A bare repo has no work tree,
  # so files kept beside it are used as they are.
  if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ]; then
    bad=$(
      for f in .gitleaks.toml .gitleaksignore; do
        [ -L "$f" ] && { printf '%s ' "$f"; continue; }
        [ -e "$f" ] || continue
        git ls-files --error-unmatch -- "$f" >/dev/null 2>&1 &&
          git diff --quiet HEAD -- "$f" >/dev/null 2>&1 && continue
        printf '%s ' "$f"
      done
    )
    if [ -n "$bad" ]; then
      echo "Blocked by the secret guard (git pre-push hook, $0): gitleaks's settings file(s) ${bad}are new, changed, a link, or not committed. gitleaks reads these files to decide what to skip, so a change to them can switch the secret scan off. If you are an agent, do not edit, delete or work around them; explain the block to the user. If the change is yours, check it and commit it (with \`git commit --no-verify\`), or undo it, then push again." >&2
      exit 1
    fi
  fi

  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    is_zero "$local_sha" && continue
    if ! is_zero "$remote_sha" && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
      # The remote ref exists and we have its commit: scan what is new.
      range="${remote_sha}..${local_sha}"
    else
      # New remote ref (or one whose current commit we don't have): scan
      # every commit being pushed that this remote is not already known
      # to hold, not just the tip.
      range="${local_sha} --not --remotes=${remote}"
    fi
    report=$(gitleaks git --no-banner --redact --no-color --ignore-gitleaks-allow --verbose --log-opts="$range" 2>&1)
    if [ "$?" = "1" ]; then
      echo "Blocked by the secret guard (git pre-push hook, $0): commit(s) about to be pushed to ${remote_ref} appear to contain a secret (gitleaks detected a match). Do not retry or work around this; rotate the credential and explain the block to the user. Details:" >&2
      printf '%s\n' "$report" >&2
      exit 1
    fi
  done <<EOF
$input
EOF
else
  echo "secret guard (git pre-push hook): gitleaks was not found on PATH, so this push was NOT scanned for secrets." >&2
fi

# core.hooksPath replaces the repo's own hooks folder, so hand on to the
# repo's own pre-push hook if it has one, with the same input.
own_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/pre-push"
if [ -x "$own_hook" ] && ! [ "$own_hook" -ef "$0" ]; then
  printf '%s\n' "$input" | "$own_hook" "$@"
  exit $?
fi

exit 0
